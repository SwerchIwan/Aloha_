<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aloha_.SupportPage"
             Title="Поддержка">
    
    <ContentPage.Resources>
        <StyleSheet Source="/style/style.css" />
    </ContentPage.Resources>

    <Frame Padding="0,0" BorderColor="White" CornerRadius="0">


        <StackLayout Orientation="Vertical" >
            <Frame HasShadow="True" BorderColor="White">
                <Grid RowDefinitions="110, 120, 100">
                    <Frame  BorderColor="White" Padding="10, 10" Grid.Row="0">
                        <Label Text="Вы всегда можете обратиться в нашу поддержку"  TextColor="Black" FontSize="22"/>
                    </Frame>
                    <VerticalStackLayout Grid.Row="1">
                        <Frame BorderColor="White" Padding="20, 0" Grid.Row="1">
                            <Label Text="Номер телефона нашей поддержки:" TextColor="Black" FontSize="16" FontAttributes="Bold" TextDecorations="Underline" />
                        </Frame>
                        <Frame BorderColor="White" Grid.Row="2" Padding="20,0">
                            <Label Text="+37525678981" TextColor="Black" FontSize="14"  />
                        </Frame>
                        <Frame BorderColor="White" Grid.Row="3" Padding="20,0">
                            <Label Text="+37525678678" TextColor="Black" FontSize="14"  />
                        </Frame>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="2">
                        <Frame BorderColor="White" Padding="20,0" Grid.Row="4">
                            <Label Text="Почта нашей поддержки:" TextDecorations="Underline" TextColor="Black" FontSize="16" FontAttributes="Bold" />
                        </Frame>
                        <Frame BorderColor="White" Grid.Row="5" Padding="20,0">
                            <Label Text="aloha_@gmail.com" TextColor="Black" FontSize="14"  />
                        </Frame>
                    </VerticalStackLayout>
                </Grid>
            </Frame>
        </StackLayout>

    </Frame>
</ContentPage>
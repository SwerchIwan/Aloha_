<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aloha_.SignIn"
             Title="SignIn">
    <ContentPage.Resources>
        <StyleSheet Source="/style/style.css" />
    </ContentPage.Resources>
    <StackLayout>

        <Frame x:Name="frameElem" CornerRadius="20" HeightRequest="450" BorderColor="#C8C8C8" HasShadow="True">
            <Grid ColumnDefinitions=" *, Auto, *" RowDefinitions="50, 50, 50, 50, 60, 60, 40 " >

                <Frame Grid.Column="1" Padding="0" BorderColor="white">
                    <Label Text="АВТОРИЗВЦИЯ" TextColor="Black" FontSize="32"></Label>
                </Frame>
                <Frame Grid.Column="1" Grid.Row="2" Padding="0" BorderColor="white">
                    <Entry Placeholder = "Введите Email"  FontSize="18" MaxLength ="20" />
                </Frame>
                <Frame Grid.Column="1" Grid.Row="3" Padding="0" BorderColor="white">
                    <Entry Placeholder = "Введите пароль"  FontSize="18" MaxLength ="20" />
                </Frame>
                <Frame Grid.Column="1" Grid.Row="6" Padding="0" >
                    <Button Text="Войти" class="buttonRegistr"></Button>
                </Frame>
                
                <Frame Grid.Column="1" Grid.Row="5" Padding="0"  BorderColor="White">
                    <Label Text="Нет аккаунта?" TextColor="Black" HorizontalOptions="Center" Margin="20" FontSize="15" class="textBold" VerticalOptions="Center"></Label>
                </Frame>
                <Frame Grid.Column="1" Grid.Row="4" Padding="0" class="frameButton" >
                    <Button Text="Зарегистрироваться" class="buttonRegistr"></Button>
                </Frame>

            </Grid>
        </Frame>
    </StackLayout>
</ContentPage>